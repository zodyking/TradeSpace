# Copy these into Dockploy → Environment (project-level), then redeploy.
#
# Required:
COMPOSE_FILE=docker-compose.yml:docker-compose.dockploy.yml
QD_PUBLIC_HOST=qauntview-quantview-lwersl-74dba7-155-138-143-191.sslip.io

# Optional (only if dokploy-network has a different name on your server):
# TRAEFIK_DOCKER_NETWORK=dokploy-network

# Do NOT set DB_PORT=5432 — it causes bind conflicts. Postgres uses internal network only.

# Also set in backend_api_python/.env (file in repo):
#   SECRET_KEY=<run: python3 -c "import secrets; print(secrets.token_hex(32))">
#   FRONTEND_URL=http://qauntview-quantview-lwersl-74dba7-155-138-143-191.sslip.io

# Domain UI (Dockploy → Domains) — or rely on traefik labels above:
#   Service: frontend | Container port: 80 | Path: / | HTTPS: OFF for sslip.io
#
# Open: http://qauntview-quantview-lwersl-74dba7-155-138-143-191.sslip.io
